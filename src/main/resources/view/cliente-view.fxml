                  <TableColumn fx:id="columnDireccionCliente" prefWidth="141.0" text="Direccion" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
      </BorderPane>
