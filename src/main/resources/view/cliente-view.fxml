<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.abarroteria.kinal.controller.ClienteController">
    <stylesheets>
        <URL value="@cliente-view.css" />
    </stylesheets>
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0" styleClass="fondo-aero" stylesheets="@../css/fondos-style.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <left>
            <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" spacing="5.0" styleClass="panel-cristal" stylesheets="@../css/glass-style.css" BorderPane.alignment="CENTER">
               <children>
                  <Button mnemonicParsing="false" styleClass="btn-primary" stylesheets="@../css/buttom-style.css" text="Agregar" />
                  <Button mnemonicParsing="false" styleClass="btn-secundary" stylesheets="@../css/buttom-style.css" text="Actualizar" />
                  <Button mnemonicParsing="false" styleClass="btn-third" stylesheets="@../css/buttom-style.css" text="Eliminar" />
               </children>
            </VBox>
         </left>
         <top>
            <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="10.0" styleClass="panel-cristal" stylesheets="@../css/glass-style.css" BorderPane.alignment="CENTER">
               <children>
                  <TextField fx:id="txtBuscarCliente" prefHeight="31.0" prefWidth="186.0" promptText="Buscar usuario..." styleClass="input-aero" stylesheets="@../css/input-style.css" />
                  <Button minWidth="84.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="84.0" styleClass="btn-secundary" stylesheets="@../css/buttom-style.css" text="Buscar" />
               </children>
            </HBox>
         </top>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
         <center>
            <TableView fx:id="tableClientes" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" styleClass="tabla-cristal" stylesheets="@../css/glass-style.css" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="columnIdCliente" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="columnNombreCliente" prefWidth="142.0" text="Nombre" />
